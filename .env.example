# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Base URL for public access (Required for Instagram Graph API to fetch images from your server)
# During local development, you can use ngrok or cloudflare tunnels (e.g., https://your-domain.ngrok-free.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Instagram Graph API Credentials (for publishing carousels)
# Requires an Instagram Business/Creator account connected to a Facebook Page
INSTAGRAM_USER_ID=your_instagram_account_id
INSTAGRAM_ACCESS_TOKEN=your_permanent_or_long_lived_user_access_token

# Optional: CRON Secret to protect the /api/cron endpoint
CRON_SECRET=your_secret_cron_key
